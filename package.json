{
  "name": "github-action-setup-atmos",
  "version": "3.7.0",
  "private": true,
  "description": "A GitHub action to setup the atmos cli",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/setup-atmos.ts -C --license licenses.txt -o dist",
    "build:wrapper": "ncc build src/wrapper.ts -m -C --license licenses.txt -o dist/wrapper",
    "clean": "rimraf dist",
    "format": "prettier --write **/*.ts",
    "format:check": "prettier --check **/*.ts",
    "lint": "eslint --fix src/**/*.ts",
    "lint:check": "eslint src/**/*.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/github-action-setup-atmos.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "step-security",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^2.0.0",
    "axios": "^1.20.0",
    "@actions/io": "^2.0.0",
    "@actions/tool-cache": "^3.0.0",
    "octokit": "^5.0.5",
    "semver": "^7.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vercel/ncc": "0.45.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-sort-destructure-keys": "^1.5.0",
    "jest": "30.5.2",
    "prettier": "3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "29.4.15",
    "typescript": "5.4.2"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=1.22.0 <2"
  }
}
